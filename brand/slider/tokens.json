{
  "name": "otomata",
  "label": "Otomata / Oto — charte maison",
  "source": "studio-otomata/brand/ (source de vérité du design Otomata). Tokens repris de brand/theme/theme.css (@otomata/ui).",
  "notes": "Ne pas modifier les couleurs ici sans les changer d'abord dans studio-otomata/brand/. Cette charte est un consommateur : en cas de divergence, brand/ a raison. Palette riso : fond crème, encre brune, saffran. Depuis le 2026-09-03 les deux marques partagent le saffran et se distinguent par la forme du mark — disque plein pour Otomata, anneau ouvert pour oto ; le violet corporate a été retiré de la plateforme.",

  "colors": {
    "primary":         { "value": "#f0b41e", "name": "Saffran",        "usage": "couleur d'identité, headers, labels, accents" },
    "primary-dark":    { "value": "#5a3b03", "name": "Saffran encre",  "usage": "texte sur fond saffran, contraste" },
    "primary-deep":    { "value": "#2c2112", "name": "Encre",          "usage": "fonds sombres, dividers, titres" },

    "signature":       { "value": "#f0b41e", "name": "Saffran",        "usage": "accents, CTAs, highlights" },
    "signature-dark":  { "value": "#e84b16", "name": "Vermillon",      "usage": "hover signature, emphase chaude" },
    "signature-deep":  { "value": "#5a3b03", "name": "Saffran profond","usage": "texte signature sur clair" },

    "accent-mint":     { "value": "#a8c926", "name": "Chartreuse",     "usage": "accent doux, succès" },

    "alert":           { "value": "#e84b16", "name": "Vermillon",      "usage": "erreurs" },
    "warning":         { "value": "#f0b41e", "name": "Saffran",        "usage": "avertissements" },
    "info":            { "value": "#2a87d8", "name": "Cobalt",         "usage": "infos" },

    "text":            { "value": "#2c2112", "name": "Encre",          "usage": "corps de texte" },
    "text-strong":     { "value": "#2c2112", "name": "Encre",          "usage": "titres" },
    "text-soft":       { "value": "#4a3a23", "name": "Encre douce",    "usage": "légendes" },
    "muted":           { "value": "#6c5e44", "name": "Mute",           "usage": "méta" },
    "muted-soft":      { "value": "#a89a78", "name": "Estompé",        "usage": "désactivé" },

    "rule":            { "value": "#dccfa8", "name": "Filet",          "usage": "filets" },
    "rule-soft":       { "value": "#ece1bd", "name": "Filet léger",    "usage": "séparateurs discrets" },

    "bg":              { "value": "#fefcf5", "name": "Crème",          "usage": "fond principal" },
    "bg-soft":         { "value": "#f4ecd2", "name": "Papier 2",       "usage": "fond alternatif" },
    "bg-canvas":       { "value": "#ebe1ba", "name": "Papier 3",       "usage": "fond institutionnel" },

    "panel-mint":      { "value": "#e6eec0", "name": "Panel chartreuse", "usage": "panneaux d'encart, statut fort" },
    "panel-teal":      { "value": "#c4dcf0", "name": "Panel cobalt",     "usage": "panneaux info" },
    "panel-cream":     { "value": "#fbe7a8", "name": "Panel saffran",    "usage": "panneaux highlights, statut partiel" }
  },

  "fonts": {
    "primary": {
      "family": "Hanken Grotesk",
      "fallback": ["Segoe UI", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"],
      "weights": [300, 400, 500, 600, 700, 800, 900],
      "source": "Google Fonts — https://fonts.google.com/specimen/Hanken+Grotesk",
      "usage": "corps de texte, tout ce qui n'est pas titre ou mono"
    },
    "display": {
      "family": "Bricolage Grotesque",
      "fallback": ["Hanken Grotesk", "system-ui", "sans-serif"],
      "weights": [300, 400, 500, 600, 700, 800],
      "source": "Google Fonts — https://fonts.google.com/specimen/Bricolage+Grotesque",
      "usage": "titres et chiffres héros. Axes variables opsz/wdth/wght — la charte utilise wdth 90, weight 600, letter-spacing négatif"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": ["Menlo", "ui-monospace", "monospace"],
      "weights": [400, 500, 700],
      "source": "Google Fonts — https://fonts.google.com/specimen/JetBrains+Mono",
      "usage": "eyebrows, kickers, étiquettes — uppercase, letter-spacing 0.16em"
    }
  },

  "type-scale": {
    "h1":     { "size_pt": 46, "weight": 600, "line_height": 0.98, "letter_spacing": "-0.025em", "font": "display" },
    "h2":     { "size_pt": 30, "weight": 600, "line_height": 1.05, "letter_spacing": "-0.02em",  "font": "display" },
    "h3":     { "size_pt": 22, "weight": 600, "line_height": 1.1,  "font": "display" },
    "lead":   { "size_pt": 13, "weight": 400, "line_height": 1.5 },
    "body":   { "size_pt": 10.5, "weight": 400, "line_height": 1.55 },
    "small":  { "size_pt": 9,    "weight": 400, "line_height": 1.4 },
    "eyebrow":{ "size_pt": 9, "weight": 700, "letter_spacing": "0.16em", "transform": "uppercase", "font": "mono" },
    "label":  { "size_pt": 8.5, "weight": 700, "letter_spacing": "0.14em", "transform": "uppercase", "font": "mono" }
  },

  "radii":   { "sm": 0, "md": 0, "lg": 0 },
  "spacing": { "page_margin_mm": 9, "gutter_mm": 6 },

  "defaults": {
    "_description": "Mark « open O » saffran par défaut (deck produit). Pour un deck au nom de la société, prendre assets/logo/otomata-mark.svg — le disque cerné.",
    "cover_photo":  null,
    "cover_logo":   "assets/logo/oto-dashboard-mark.svg",
    "header_logo":  "assets/logo/oto-dashboard-mark.svg"
  }
}
