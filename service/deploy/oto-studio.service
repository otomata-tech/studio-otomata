[Unit]
Description=oto studio — rendu de visuels (API + IHM)
Documentation=https://github.com/otomata-tech/studio-otomata
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/oto-studio
ExecStart=/usr/bin/node service/server.mjs
Restart=on-failure
RestartSec=5

# Deux chemins d'accès, deux publics :
#   · les HUMAINS passent par Caddy (443) et Cloudflare Access — app « studio.oto.zone »,
#     règle `email_domain otomata.tech` ;
#   · les AGENTS passent par le Private Network (172.16.16.0/22), sans Cloudflare et sans
#     secret : c'est le montage du pont Movinmotion. Nécessaire parce que le connecteur
#     `http` d'oto ne sait poser QU'UN en-tête, là où Access en exige deux — il ne peut
#     donc pas franchir Access, quoi qu'on fasse.
# D'où l'écoute sur 0.0.0.0 : ce qui ferme la porte côté Internet est le groupe de
# sécurité `otomata-0-sg` (politique inbound = drop ; seuls 80, 443, 45876 depuis le hub
# de supervision, et ANY depuis 172.16.16.0/22). Le port 8100 n'y est PAS ouvert
# publiquement. ⚠️ Ce service n'a aucune auth applicative : si cette règle changeait, il
# serait pilotable par quiconque atteint le port. À revérifier avant tout élargissement.
Environment=STUDIO_HOST=0.0.0.0
Environment=STUDIO_PORT=8100
Environment=STUDIO_CHROME=/usr/bin/google-chrome
Environment=STUDIO_CHROME_IDLE_MS=600000
Environment=STUDIO_KEEP=60

# Les secrets ne sont PAS dans cette unité, qui est versionnée : ils vivent dans un
# fichier 600 sur la box, dont la valeur de référence est un item 1Password. Le `-` rend
# le fichier facultatif — sans lui, le studio démarre et rend des visuels, seule la
# retouche IA de l'atelier photo répond 503 avec son motif.
#   GEMINI_API_KEY — « Google Gemini — API modèle d'image (plateforme oto) », coffre oto
EnvironmentFile=-/opt/oto-studio/.env

# ⚠️ SANS CES TROIS LIGNES, RIEN NE PLAFONNE CE SERVICE. Les garde-fous mémoire posés
# sur cette box après les gels du 30/06 et du 06/08 ne couvrent que `user-*.slice` et
# les unités `actions.runner.*` : `system.slice` a `memory.max = max`. Une unité de
# rendu qui y tombe sans limite, c'est le troisième gel.
# Calibrage : pointe mesurée ~900 Mo par rendu (une carte 1080×1080, 121 images).
# Dépasser le plafond tue le rendu — un rendu perdu, pas une box à redémarrer.
MemoryHigh=1G
MemoryMax=1400M
MemorySwapMax=256M

# Le rendu est du travail de fond : il cède le pas à tout ce qui sert du trafic.
Nice=10
CPUWeight=50

# /tmp privé : le profil Chrome et les images intermédiaires n'atterrissent pas dans
# le /tmp partagé de la box.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
